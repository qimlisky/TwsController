<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 对应 Python 版 ui/theme.py 的 FluentPalette(dark=True)：
         bg rgba(32,32,32,215) / card rgba(255,255,255,.045) / accent #4CC2FF 等。
         不含 Acrylic（WPF 无原生模糊），用高不透明度近黑保证可读性。 -->
    <SolidColorBrush x:Key="RootBrush" Color="#FA202020" />
    <SolidColorBrush x:Key="CardBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="DisTextBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6EBFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF00314C" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="TrackOnBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="IconBrush" Color="#C7FFFFFF" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000" />
    <Color x:Key="ShadowColor">#66000000</Color>
    <SolidColorBrush x:Key="MenuBrush" Color="#F5202020" />
    <SolidColorBrush x:Key="MenuStrokeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#1FFFFFFF" />
</ResourceDictionary>

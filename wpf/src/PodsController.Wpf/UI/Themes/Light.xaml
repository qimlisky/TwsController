<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 对应 Python 版 ui/theme.py 的 FluentPalette(dark=False)：
         bg rgba(243,243,243,220) / card rgba(0,0,0,.035) / accent #0067C0 等。 -->
    <SolidColorBrush x:Key="RootBrush" Color="#FAF3F3F3" />
    <SolidColorBrush x:Key="CardBrush" Color="#09000000" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6000000" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#94000000" />
    <SolidColorBrush x:Key="DisTextBrush" Color="#57000000" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#14000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#17000000" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1975C8" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2E000000" />
    <SolidColorBrush x:Key="TrackOnBrush" Color="#FF0067C0" />
    <SolidColorBrush x:Key="IconBrush" Color="#B8000000" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFD13438" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#40000000" />
    <Color x:Key="ShadowColor">#40000000</Color>
    <SolidColorBrush x:Key="MenuBrush" Color="#FAF9F9F9" />
    <SolidColorBrush x:Key="MenuStrokeBrush" Color="#22000000" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#14000000" />
</ResourceDictionary>

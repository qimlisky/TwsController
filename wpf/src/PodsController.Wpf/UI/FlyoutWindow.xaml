<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PodsController.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PodsController.UI.Controls"
        Title="TwsController"
        Width="372" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" FontSize="12.5"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border x:Name="RootBorder" CornerRadius="10" Margin="8"
            Background="{DynamicResource RootBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1">
        <Border Padding="12,10,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ================= 标题栏 ================= -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" Margin="0,0,0,8"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                            Background="Transparent" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Image x:Name="TitleIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock x:Name="DeviceNameText" Style="{StaticResource TitleStyle}" />
                        <TextBlock x:Name="WearText" Style="{StaticResource FootnoteStyle}" Margin="0,1,0,0" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource StatusStyle}" Margin="0,1,0,0" />
                    </StackPanel>

                    <Button x:Name="FoldButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,2,0" Click="FoldButton_Click" ToolTip="折叠 / 展开">
                        <TextBlock x:Name="FoldIcon" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="PinButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,2,0" Click="PinButton_Click" ToolTip="固定浮窗">
                        <TextBlock x:Name="PinIcon" Text="&#xE840;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="SettingsButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,2,0" Click="SettingsButton_Click" ToolTip="设置">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="CloseButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                            Click="CloseButton_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- ================= 内容 ================= -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0"
                                  Focusable="False">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="BodyStack">

                            <!-- 电量 -->
                            <TextBlock x:Name="BatteryTitle" Text="电量" Style="{StaticResource SectionStyle}"
                                       Margin="0,0,0,2" />
                            <UniformGrid x:Name="BatteryGrid" Columns="3" Margin="0,0,0,8">
                                <Border x:Name="LeftPill" Style="{StaticResource CardStyle}" Height="66"
                                        Padding="8,6" Margin="0,0,4,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock x:Name="LeftName" Text="左耳" FontSize="10.5"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                            <Path x:Name="LeftBolt" Width="10" Height="10" Stretch="Uniform"
                                                  Data="M13 2L5 13h5l-1 9 8-11h-5z"
                                                  Fill="{DynamicResource AccentBrush}" Margin="3,0,0,0"
                                                  VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <controls:BatteryIcon x:Name="LeftBattery" Width="34" Height="12"
                                                                  Percent="-1" Margin="0,0,7,0"
                                                                  StrokeBrush="{DynamicResource SubTextBrush}"
                                                                  FillBrush="{DynamicResource AccentBrush}"
                                                                  LowBrush="{DynamicResource WarnBrush}" />
                                            <TextBlock x:Name="LeftPercentText" Text="—" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="LeftCaption" Grid.Row="2" Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center" Text="" />
                                    </Grid>
                                </Border>
                                <Border x:Name="RightPill" Style="{StaticResource CardStyle}" Height="66"
                                        Padding="8,6" Margin="2,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock x:Name="RightName" Text="右耳" FontSize="10.5"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                            <Path x:Name="RightBolt" Width="10" Height="10" Stretch="Uniform"
                                                  Data="M13 2L5 13h5l-1 9 8-11h-5z"
                                                  Fill="{DynamicResource AccentBrush}" Margin="3,0,0,0"
                                                  VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <controls:BatteryIcon x:Name="RightBattery" Width="34" Height="12"
                                                                  Percent="-1" Margin="0,0,7,0"
                                                                  StrokeBrush="{DynamicResource SubTextBrush}"
                                                                  FillBrush="{DynamicResource AccentBrush}"
                                                                  LowBrush="{DynamicResource WarnBrush}" />
                                            <TextBlock x:Name="RightPercentText" Text="—" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="RightCaption" Grid.Row="2" Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center" Text="" />
                                    </Grid>
                                </Border>
                                <Border x:Name="CasePill" Style="{StaticResource CardStyle}" Height="66"
                                        Padding="8,6" Margin="4,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock x:Name="CaseName" Text="充电盒" FontSize="10.5"
                                                       Foreground="{DynamicResource SubTextBrush}" />
                                            <Path x:Name="CaseBolt" Width="10" Height="10" Stretch="Uniform"
                                                  Data="M13 2L5 13h5l-1 9 8-11h-5z"
                                                  Fill="{DynamicResource AccentBrush}" Margin="3,0,0,0"
                                                  VerticalAlignment="Center" Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <controls:BatteryIcon x:Name="CaseBattery" Width="34" Height="12"
                                                                  Percent="-1" Margin="0,0,7,0"
                                                                  StrokeBrush="{DynamicResource SubTextBrush}"
                                                                  FillBrush="{DynamicResource AccentBrush}"
                                                                  LowBrush="{DynamicResource WarnBrush}" />
                                            <TextBlock x:Name="CasePercentText" Text="—" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="CaseCaption" Grid.Row="2" Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center" Text="" />
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- 折叠态：紧凑降噪 -->
                            <Border x:Name="CompactNoiseSeg" Style="{StaticResource CardStyle}" Padding="3"
                                    Margin="0,0,0,8" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="CompactAncButton" Grid.Column="0" Content="降噪"
                                                  Style="{StaticResource SegmentCompactStyle}" Click="NoiseAnc_Click" />
                                    <ToggleButton x:Name="CompactOffButton" Grid.Column="1" Content="关闭"
                                                  Style="{StaticResource SegmentCompactStyle}" Click="NoiseOff_Click" />
                                    <ToggleButton x:Name="CompactTransparencyButton" Grid.Column="2" Content="通透"
                                                  Style="{StaticResource SegmentCompactStyle}" Click="NoiseTransparency_Click" />
                                </Grid>
                            </Border>

                            <!-- 出声模式 -->
                            <TextBlock x:Name="NoiseTitle" Text="出声模式" Style="{StaticResource SectionStyle}"
                                       Margin="0,0,0,2" />
                            <Border x:Name="NoiseSection" Style="{StaticResource CardStyle}" Padding="3"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="NoiseAncButton" Grid.Column="0" Content="降噪"
                                                  Style="{StaticResource SegmentToggleStyle}" Click="NoiseAnc_Click" />
                                    <ToggleButton x:Name="NoiseOffButton" Grid.Column="1" Content="关闭"
                                                  Style="{StaticResource SegmentToggleStyle}" Click="NoiseOff_Click" />
                                    <ToggleButton x:Name="NoiseTransparencyButton" Grid.Column="2" Content="通透"
                                                  Style="{StaticResource SegmentToggleStyle}" Click="NoiseTransparency_Click" />
                                </Grid>
                            </Border>

                            <!-- 多设备连接（对应 Python 的 dual 分区，演示 OPPO 不显示） -->
                            <StackPanel x:Name="MultiSection" Visibility="Collapsed" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="多设备连接" Style="{StaticResource SectionStyle}" />
                                    <Border Style="{StaticResource BadgeStyle}" Margin="6,0,0,0">
                                        <TextBlock Text="实验" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl x:Name="MultiList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Padding="10,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                                   Foreground="{DynamicResource DisTextBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                               FontSize="10.5" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SubTextBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 空间音频 -->
                            <Border x:Name="SpatialRow" Style="{StaticResource CardStyle}" Height="48"
                                    Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          Data="M12 3l8 3.5v5c0 5-3.4 8-8 9.5-4.6-1.5-8-4.5-8-9.5v-5L12 3z"
                                          Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="3D 全景声（头部固定）" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <Border x:Name="SpatialBadge" Style="{StaticResource BadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock Text="实验" Style="{StaticResource BadgeTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="空间音频" Style="{StaticResource SubtitleStyle}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SpatialSwitch" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                                                  VerticalAlignment="Center" Click="SpatialSwitch_Click" />
                                </Grid>
                            </Border>

                            <!-- 低延迟游戏 -->
                            <Border x:Name="GameRow" Style="{StaticResource CardStyle}" Height="48"
                                    Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          Data="M6 9h12a3 3 0 0 1 3 3 3 3 0 0 1-5 2.2l-.6-.7H8.6l-.6.7A3 3 0 1 1 3 12a3 3 0 0 1 3-3z"
                                          Stroke="{DynamicResource IconBrush}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="缩短音频延迟" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <Border x:Name="GameBadge" Style="{StaticResource BadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock Text="实验" Style="{StaticResource BadgeTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="低延迟游戏" Style="{StaticResource SubtitleStyle}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="GameSwitch" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                                                  VerticalAlignment="Center" Click="GameSwitch_Click" />
                                </Grid>
                            </Border>

                            <!-- 音效 -->
                            <TextBlock x:Name="EqTitle" Text="音效（EQ）" Style="{StaticResource SectionStyle}"
                                       Margin="0,0,0,4" />
                            <WrapPanel x:Name="EqPanel" Margin="0,0,0,2" />

                            <!-- 查找耳机 -->
                            <ToggleButton x:Name="FindButton" Style="{StaticResource FindToggleStyle}"
                                          HorizontalAlignment="Stretch" Height="34" Click="Find_Click"
                                          Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M11 4a7 7 0 1 0 4.2 12.6l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4z"
                                          Stroke="{Binding Foreground, ElementName=FindButton}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock x:Name="FindText" Text="查找耳机" Margin="6,0,0,0"
                                               Foreground="{Binding Foreground, ElementName=FindButton}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 未连接 -->
                    <Border x:Name="EmptySection" Style="{StaticResource CardStyle}" Padding="14,16"
                            VerticalAlignment="Top" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <Image x:Name="DisconnectPhoto" Width="52" Height="52" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="未连接到耳机" FontSize="11" FontWeight="DemiBold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                            <Button x:Name="ConnectButton" Content="选择耳机（vivo / 华为 / OPPO / Redmi）"
                                    Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0"
                                    Click="ConnectButton_Click" />
                            <TextBlock x:Name="DetectText" Style="{StaticResource FootnoteStyle}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ErrorText" Style="{StaticResource SubtitleStyle}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- 关于页 -->
                    <Grid x:Name="AboutPanel" Background="{DynamicResource RootBrush}" Visibility="Collapsed"
                          Margin="-12,-10,-12,-12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="← 返回" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left" Margin="12,10,0,0" Padding="8,4"
                                Click="AboutBack_Click" />
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,0,0,20">
                            <Image x:Name="AboutIcon" Width="128" Height="128" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="TwsController" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                            <TextBlock x:Name="AboutVersionText" Style="{StaticResource SubtitleStyle}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock x:Name="AboutAuthorText" Style="{StaticResource SubtitleStyle}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="AboutCreditText" FontSize="9.5" TextWrapping="Wrap"
                                       TextAlignment="Center" Width="280"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= Toast ================= -->
                <Border x:Name="ToastBorder" Grid.Row="2" Background="{DynamicResource CardAltBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="8,6" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ToastText" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                </Border>

                <!-- ================= 固件 ================= -->
                <TextBlock x:Name="FirmwareText" Grid.Row="3" Style="{StaticResource FootnoteStyle}"
                           HorizontalAlignment="Right" Margin="0,6,0,0" />
            </Grid>
        </Border>
    </Border>
</Window>
